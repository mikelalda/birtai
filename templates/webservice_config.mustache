{{!
    @template aiprovider_birtai/webservice_config

    TODO describe template webservice_config

    Example context (json):
    {
        "isconfigured": true,
        "needsrepair": false,
        "webservicesenabled": true,
        "restenabled": true,
        "user": {
            "username": "birtai_user",
            "email": "birtai@example.com"
        },
        "role": {
            "shortname": "birtai_role",
            "name": "birtai AI Role"
        },
        "service": {
            "name": "birtai AI Service"
        },
        "userassigned": true,
        "tokenexists": true,
        "tokencreated": "2025-01-15 10:30:00",
        "registration": {
            "verified": true,
            "lastsent": "2025-01-15 10:30:00"
        },
        "messages": []
    }
}}

<div data-region="aiprovider_birtai/webservice-root">
    <div class="mb-4">
        <h3>{{#str}} webserviceconfig_heading, aiprovider_birtai {{/str}}</h3>
        <p class="text-muted">{{#str}} webserviceconfig_desc, aiprovider_birtai {{/str}}</p>
    </div>

    <!-- Status Overview Card -->
    <div class="card mb-4">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">{{#str}} webserviceconfig_current, aiprovider_birtai {{/str}}</h5>
            {{#isconfigured}}
                <span class="badge badge-success" data-region="aiprovider_birtai/header-badge">{{#str}} configured, aiprovider_birtai{{/str}}</span>
            {{/isconfigured}}
            {{^isconfigured}}
                {{#retryonly}}
                    <span class="badge badge-warning" data-region="aiprovider_birtai/header-badge">{{#str}} needs_repair, aiprovider_birtai{{/str}}</span>
                {{/retryonly}}
                {{^retryonly}}
                    {{#registration.lastsent}}
                        {{#needsrepair}}
                            <span class="badge badge-warning" data-region="aiprovider_birtai/header-badge">{{#str}} needs_repair, aiprovider_birtai{{/str}}</span>
                        {{/needsrepair}}
                        {{^needsrepair}}
                            <span class="badge badge-danger" data-region="aiprovider_birtai/header-badge">{{#str}} not_configured, aiprovider_birtai{{/str}}</span>
                        {{/needsrepair}}
                    {{/registration.lastsent}}
                    {{^registration.lastsent}}
                        <span class="badge badge-danger" data-region="aiprovider_birtai/header-badge">{{#str}} not_configured, aiprovider_birtai{{/str}}</span>
                    {{/registration.lastsent}}
                {{/retryonly}}
            {{/isconfigured}}
        </div>
        <div class="card-body">
            {{> aiprovider_birtai/webservice/status }}

            {{> aiprovider_birtai/webservice/user_role }}

            {{> aiprovider_birtai/webservice/service_assignment }}

            {{> aiprovider_birtai/webservice/token_registration }}
        </div>
    </div>

    <!-- Action Buttons -->
    {{> aiprovider_birtai/webservice/actions }}

    <!-- Activity Log -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <small class="text-muted">{{#str}} live_log, aiprovider_birtai{{/str}}</small>
        </div>
        <div class="card-body">
            <ul class="list-unstyled mb-0" data-region="aiprovider_birtai/webservice-log">
                <!-- Activity log entries will be populated here -->
            </ul>
        </div>
    </div>
</div>
