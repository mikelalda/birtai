{{!
    @template aiprovider_birtai/header_logo

    Display plugin header with optional birtai logo.

    Example context (json):
    {
        "pluginname": "birtai AI Provider",
        "logourl": "https://birtai.com/logo.png"
    }
}}

<div class="birtai-header d-flex flex-wrap align-items-center justify-content-between mb-3 gap-2">
    {{#pluginname}}
        <h2 class="m-0">{{.}}</h2>
    {{/pluginname}}
    {{#logourl}}
        <a href="https://birtai.com/" target="_blank" rel="noopener noreferrer" class="d-flex align-items-center">
            <img src="{{.}}" alt="{{#str}}alt_birtai_icon, aiprovider_birtai{{/str}}" style="height:35px;">
        </a>
    {{/logourl}}
</div>
